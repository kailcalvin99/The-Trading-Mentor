# Local development example for The Trading Mentor.
# Copy to .env locally. Do not commit real secret values.

PORT=5173
BASE_PATH=/web/

DATABASE_URL=postgresql://user:password@localhost:5432/trading_mentor

SESSION_SECRET=replace-with-local-secret
JWT_SECRET=replace-with-local-secret
ALLOWED_ORIGINS=http://localhost:5173,https://thetradingmentorai.com
APP_DOMAIN=https://thetradingmentorai.com
PUBLIC_DOMAIN=https://thetradingmentorai.com

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

VITE_API_URL=/api

AI_INTEGRATIONS_GEMINI_BASE_URL=
AI_INTEGRATIONS_GEMINI_API_KEY=

EXPO_PUBLIC_DOMAIN=localhost:5173
